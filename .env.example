# Copy to .env.local (PowerShell: Copy-Item .env.example .env.local)
# Never commit real values here — this file is tracked, .env.local is not.

# MongoDB connection string for the Better Auth session store
MONGODB_URI=mongodb+srv://<db-user>:<db-password>@<cluster-host>/?retryWrites=true&w=majority
# Must match the existing DB on the cluster (case-sensitive: "studiospace" is rejected, code 13297)
DB_NAME=StudioSpace
# 32+ random bytes, e.g. `openssl rand -base64 32` or `node -e "console.log(crypto.randomUUID())"`
BETTER_AUTH_SECRET=<generate-a-random-secret>
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=<google-oauth-client-id>.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=<google-oauth-client-secret>
# Must match JWT_SECRET in the server .env
JWT_SECRET=<same-value-as-server-jwt-secret>
# Express server base URL (used by the /server-api proxy)
API_URL=http://localhost:5000
# Optional: imgbb key for in-form image uploads
NEXT_PUBLIC_IMGBB_KEY=
